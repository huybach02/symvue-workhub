<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xác thực OTP</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Roboto', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px 15px;
            line-height: 1.5;
        }
        
        .email-container {
            max-width: 500px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        }
        
        .header {
            background: linear-gradient(135deg, #1976D2 0%, #1565C0 100%);
            padding: 25px 20px;
            text-align: center;
            color: #ffffff;
        }
        
        .header h1 {
            font-size: 22px;
            font-weight: 500;
            margin-bottom: 5px;
            letter-spacing: 0.3px;
        }
        
        .header p {
            font-size: 13px;
            opacity: 0.9;
            font-weight: 300;
        }
        
        .content {
            padding: 30px 25px;
            text-align: center;
        }
        
        .greeting {
            font-size: 16px;
            color: #424242;
            margin-bottom: 12px;
            font-weight: 400;
        }
        
        .message {
            font-size: 14px;
            color: #757575;
            margin-bottom: 25px;
            line-height: 1.6;
        }
        
        .otp-container {
            background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
            border-radius: 10px;
            padding: 25px 20px;
            margin: 20px 0;
            border: 2px solid #e0e0e0;
        }
        
        .otp-code {
            font-size: 40px;
            font-weight: 700;
            color: #1976D2;
            letter-spacing: 8px;
            font-family: 'Courier New', monospace;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
        }
        
        .expiry-notice {
            margin-top: 20px;
            padding: 15px;
            background: #fff3cd;
            border-left: 3px solid #ffc107;
            border-radius: 6px;
            text-align: center;
        }
        
        .expiry-notice p {
            font-size: 13px;
            color: #856404;
            margin: 0;
        }
        
        .expiry-notice strong {
            color: #664d03;
        }
        
        .footer {
            background: #f5f5f5;
            padding: 20px 25px;
            text-align: center;
            border-top: 1px solid #e0e0e0;
        }
        
        .footer p {
            font-size: 12px;
            color: #9e9e9e;
            margin-bottom: 5px;
        }
        
        .footer .company-name {
            font-weight: 500;
            color: #1976D2;
            font-size: 13px;
        }
        
        @media only screen and (max-width: 600px) {
            body {
                padding: 15px 10px;
            }
            
            .email-container {
                border-radius: 10px;
            }
            
            .header {
                padding: 20px 15px;
            }
            
            .header h1 {
                font-size: 20px;
            }
            
            .content {
                padding: 20px 15px;
            }
            
            .otp-code {
                font-size: 28px;
                letter-spacing: 3px;
            }
            
            .footer {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="header">
            <h1>🔐 Xác Thực Tài Khoản</h1>
            <p>Mã xác thực một lần (OTP)</p>
        </div>
        
        <!-- Content -->
        <div class="content">
            <p class="greeting">Xin chào,</p>
            
            <p class="message">
                Mã xác thực OTP của bạn:
            </p>
            
            <!-- OTP Box -->
            <div class="otp-container">
                <div class="otp-code">{{ otp }}</div>
            </div>
            
            <!-- Expiry Notice -->
            <div class="expiry-notice">
                <p>
                    Mã có hiệu lực trong <strong>{{ expire }} phút</strong>. Không chia sẻ mã này với bất kỳ ai.
                </p>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="footer">
            <p class="company-name">Symfony Vue Boilerplate</p>
            <p>Email này được gửi tự động, vui lòng không trả lời.</p>
            <p>&copy; {{ "now"|date("Y") }} All rights reserved.</p>
        </div>
    </div>
</body>
</html>
