{% extends 'base.html.twig' %}

{% block title %}{{ projectName }} | Backend{% endblock %}

{% block body %}
    <main class="landing-shell">
        <section class="landing-hero">
            <p class="landing-eyebrow">Backend service</p>
            <h1>{{ projectName }}</h1>
            <p class="landing-summary">
                Backend server is running normally. This page provides a quick overview of the technology stack used across the full project, including the API, admin frontend, and deployment layer.
            </p>

            <div class="landing-meta">
                <div class="meta-card">
                    <span class="meta-label">API Base</span>
                    <strong>/api</strong>
                </div>
                <div class="meta-card">
                    <span class="meta-label">Frontend</span>
                    <strong>Vue Admin</strong>
                </div>
                <div class="meta-card">
                    <span class="meta-label">Realtime</span>
                    <strong>Mercure</strong>
                </div>
            </div>
        </section>

        <section class="stack-grid">
            <article class="stack-card">
                <div class="stack-heading">
                    <p>Backend</p>
                    <h2>Core API stack</h2>
                </div>
                <ul class="stack-list">
                    {% for item in backendStack %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </article>

            <article class="stack-card">
                <div class="stack-heading">
                    <p>Frontend</p>
                    <h2>Admin application</h2>
                </div>
                <ul class="stack-list">
                    {% for item in frontendStack %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </article>

            <article class="stack-card">
                <div class="stack-heading">
                    <p>Infrastructure</p>
                    <h2>Deployment layer</h2>
                </div>
                <ul class="stack-list">
                    {% for item in infrastructureStack %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </article>
        </section>

        <section class="highlights-card">
            <div class="stack-heading">
                <p>Capabilities</p>
                <h2>Project highlights</h2>
            </div>
            <ul class="feature-list">
                {% for item in apiHighlights %}
                    <li>{{ item }}</li>
                {% endfor %}
            </ul>
        </section>
    </main>
{% endblock %}
